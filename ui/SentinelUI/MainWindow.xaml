<Window x:Class="SentinelUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SentinelAI - Next-Gen Malware Analysis Engine" 
        Height="720" Width="950" 
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter">

    <Window.Resources>
        <!-- Modern ScrollViewer Stili -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Buton Stili -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <!-- Üst Bar (Header) -->
            <RowDefinition Height="Auto"/>
            <!-- Dosya Yükleme / Sürükle-Bırak Alanı -->
            <RowDefinition Height="Auto"/>
            <!-- Sonuç Paneli (Dashboard) -->
            <RowDefinition Height="*"/>
            <!-- Alt Bilgi (Footer) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST BAR (HEADER) -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="12" Width="48" Height="48" Margin="0,0,16,0">
                    <TextBlock Text="🛡️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SENTINEL" FontSize="22" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="AI" FontSize="22" FontWeight="Black" Foreground="#38BDF8" Margin="4,0,0,0"/>
                        <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="10,2,0,2" VerticalAlignment="Center">
                            <TextBlock Text="v1.0 HYBRID" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Yapay Zekâ ve Kural Tabanlı Çok Katmanlı Güvenlik Motoru" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Durum Rozeti -->
            <Border Grid.Column="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Name="ApiStatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtApiStatus" Text="API Çevrimiçi (127.0.0.1:8000)" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. SÜRÜKLE-BIRAK & DOSYA SEÇİM ALANI -->
        <Border Grid.Row="1" Name="DropZoneBorder" Background="#111827" BorderBrush="#1E293B" BorderThickness="2" CornerRadius="14" Padding="24" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Simge -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Width="52" Height="52" Margin="0,0,20,0">
                    <TextBlock Text="📂" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Açıklama -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="TxtDropTitle" Text="Analiz edilecek dosyayı buraya sürükleyin" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Name="TxtSelectedFilePath" Text=".exe, .dll veya taranacak herhangi bir dosyayı seçebilirsiniz" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Buton -->
                <Button Grid.Column="2" Name="BtnSelectFile" Style="{StaticResource CyberButton}" Content="Dosya Seç" Click="BtnSelectFile_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 3. DETAYLI SONUÇ DASHBOARD'U -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Sol: Ana Tehdit Skoru Kartı -->
                <ColumnDefinition Width="320"/>
                <!-- Sağ: Alt Modül Detayları -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL: GENEL KARAR & RİSK SKORU -->
            <Border Grid.Column="0" Background="#111827" CornerRadius="14" Padding="24" Margin="0,0,16,0" BorderBrush="#1E293B" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="GÜVENLİK ANALİZİ" FontSize="12" FontWeight="Bold" Foreground="#64748B"/>

                    <!-- Merkezdeki Büyük Gösterge -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Name="VerdictBadge" Background="#1E293B" CornerRadius="50" Width="100" Height="100" Margin="0,0,0,16">
                            <TextBlock Name="TxtVerdictIcon" Text="🛡️" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <TextBlock Name="TxtVerdictTitle" Text="Beklemede" FontSize="24" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Name="TxtRiskPercentage" Text="Risk Skoru: --" FontSize="15" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                        <!-- İlerleme Çubuğu -->
                        <Border Background="#1E293B" CornerRadius="5" Height="8" Width="200" Margin="0,16,0,0">
                            <ProgressBar Name="RiskProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#10B981" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </StackPanel>

                    <!-- Alt Durum Mesajı -->
                    <TextBlock Grid.Row="2" Name="TxtStatusMessage" Text="Henüz bir dosya taranmadı." FontSize="12" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- SAĞ PANEL: MODÜL AYRINTILARI -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. KART: YAPAY ZEKÂ (DEEP LEARNING) MODÜLÜ -->
                <Border Grid.Row="0" Background="#111827" CornerRadius="14" Padding="20" Margin="0,0,0,12" BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧠" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="AI Engine (PyTorch + EMBER)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                            <Border Name="AiPill" DockPanel.Dock="Right" Background="#1E293B" CornerRadius="12" Padding="10,3" HorizontalAlignment="Right">
                                <TextBlock Name="TxtAiPill" Text="Hazır" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            </Border>
                        </DockPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Yapay Zekâ Tehdit İhtimali:" FontSize="13" Foreground="#94A3B8"/>
                                <TextBlock Grid.Column="1" Name="TxtAiScoreValue" Text="0.0000" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            </Grid>
                            <TextBlock Text="Model PE başlıklarını, kütüphane bağlantılarını ve kod karmaşıklığını inceledi." FontSize="12" Foreground="#64748B" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. KART: YARA KURAL MODÜLÜ & RAW LOGLAR -->
                <Border Grid.Row="1" Background="#111827" CornerRadius="14" Padding="20" BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="YARA Engine (Statik Analiz)" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                            <Border Name="YaraPill" DockPanel.Dock="Right" Background="#1E293B" CornerRadius="12" Padding="10,3" HorizontalAlignment="Right">
                                <TextBlock Name="TxtYaraPill" Text="Hazır" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            </Border>
                        </DockPanel>

                        <!-- Tespit Edilen Kurallar Listesi -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <TextBlock Name="TxtYaraDetails" Text="Eşleşen şüpheli kural veya bayt örüntüsü yok." FontSize="12" Foreground="#64748B" FontFamily="Consolas" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. ALT BİLGİ (FOOTER) -->
        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="SentinelAI Hybrid Security Architecture" FontSize="12" Foreground="#475569"/>
            <TextBlock DockPanel.Dock="Right" Text="Deep Learning &amp; Reverse Engineering Powered" FontSize="12" Foreground="#475569" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
